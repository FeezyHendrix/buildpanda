# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=buildpanda

# Backend
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buildpanda
DB_USER=postgres
DB_PASSWORD=postgres

# Better Auth
# REQUIRED in production — the server refuses to boot without it (an empty
# signing secret would let anyone forge sessions). Generate 32+ random chars.
BETTER_AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Allowed CORS / trusted origins (comma-separated): app (5173) + admin panel (5174).
# Feeds BOTH @fastify/cors AND better-auth `trustedOrigins`. Use exact scheme+host,
# NO trailing slash. In production this MUST include the deployed frontend origin(s),
# e.g. CORS_ORIGIN=https://watchtower.buildpanda.io,https://buildpanda.io,https://www.buildpanda.io
# Missing the frontend origin here causes "No 'Access-Control-Allow-Origin' header" on sign-in.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Platform super-admins (comma-separated emails). These accounts are
# auto-promoted to the global `admin` role on login and can access the admin panel.
ADMIN_EMAILS=

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SendByte (transactional email). The key is the "sk_live_..." / "sk_test_..."
# API key from https://app.sendbyte.africa.
# Leave empty in local dev to log emails to the console instead of sending them.
SENDBYTE_API_KEY=your-sendbyte-api-key
SENDBYTE_FROM_ADDRESS=noreply@buildpanda.io
SENDBYTE_FROM_NAME=BuildPanda
# Monitored address replies go to (improves deliverability vs a bare noreply@)
SENDBYTE_REPLY_TO=hello@buildpanda.io
# Publicly reachable logo for email headers (inboxes cannot load localhost).
# Defaults to https://buildpanda.io/logo.png
# EMAIL_LOGO_URL=https://buildpanda.io/logo.png

# Inboxes that receive "Book a consultation" leads from buildpanda.io (comma-separated)
LEADS_NOTIFY_EMAIL=buildpanda.io@gmail.com,michaelade.build@gmail.com

# Object Storage — local dev uses MinIO via docker-compose; prod points at real S3.
# Leave S3_ENDPOINT blank in prod so the AWS SDK uses the default S3 endpoint.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=buildpanda
S3_FORCE_PATH_STYLE=true
S3_ENSURE_BUCKET=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# SSE-S3 (AES256) on server-side uploads. Defaults ON for real S3 (blank
# S3_ENDPOINT) and OFF for local MinIO (which needs KES/KMS for SSE). For
# presigned client uploads, enable bucket default encryption on the bucket
# instead. Leave unset to use the smart default.
# S3_SERVER_SIDE_ENCRYPTION=true

# Per-upload size limit in bytes (default 25 MB)
UPLOAD_MAX_BYTES=26214400

# Expo OTA updates. Shared secret CI presents to POST /ota/publish. Leave empty
# and publishing is refused outright — the manifest endpoint stays read-only.
OTA_PUBLISH_TOKEN=
# Per-asset size limit for a published update bundle (default 64 MB)
OTA_MAX_ASSET_BYTES=67108864

# Web push notifications (VAPID key pair). Generate once with
# `npx web-push generate-vapid-keys`. Leave empty to disable push entirely —
# the app hides the toggle and delivery logs instead of sending.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:hello@buildpanda.io
WEB_PUSH_CONTACT=

# Frontend
VITE_API_BASE_URL=http://localhost:3000

# Background jobs (Redis). Leave empty to run the queue in inline mode without
# a Redis server. In docker-compose / Railway set this to the Redis service URL.
# When set, Redis also backs the HTTP rate limiter (shared counters across
# instances); without it the limiter falls back to a per-process in-memory store.
REDIS_URL=redis://localhost:6379

# HTTP rate limiting. Global baseline applies to every request; auth endpoints
# are throttled separately by better-auth, and public token/lead routes have
# tighter per-route caps. Set RATE_LIMIT_ENABLED=false to disable entirely.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# Clustering / scaling (Node.js multi-core). Clustering only engages when
# REDIS_URL is set AND the worker count is > 1; otherwise the server runs as a
# single process. WEB_CONCURRENCY is honored as a fallback (Railway sets it).
# Exactly one fork runs the background workers + cron jobs (RUN_WORKERS); the
# rest serve HTTP only, so reminders/recomputes never fire more than once.
# Do not set RUN_WORKERS by hand in clustered mode — the primary assigns it.
# DB_POOL_MAX is per process; with N forks the total Postgres connections are
# N * DB_POOL_MAX, so size it against the database's max_connections.
CLUSTER_WORKERS=1
# WEB_CONCURRENCY=
# RUN_WORKERS=true
DB_POOL_MAX=10

# Panda AI (Moonshot / KIMI). Leave KIMI_API_KEY empty to use the built-in
# deterministic analyzer instead of calling the hosted model.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0905-preview

# OpenAI — preferred provider for BoQ material extraction (falls back to KIMI,
# then a deterministic parser, when empty).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Sentry error monitoring. Only active in production (NODE_ENV=production, i.e.
# on Railway) AND when SENTRY_DSN is set — it stays OFF in local/dev regardless,
# so a DSN here won't send events from your machine. SENTRY_TRACES_SAMPLE_RATE
# controls trace sampling (0.0-1.0); defaults to 0.1 in production.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1


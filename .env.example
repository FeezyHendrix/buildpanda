# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=buildpanda

# Backend
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buildpanda
DB_USER=postgres
DB_PASSWORD=postgres

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ZeptoMail (transactional email)
ZEPTOMAIL_TOKEN=your-zeptomail-send-mail-token
ZEPTOMAIL_FROM_ADDRESS=noreply@yourdomain.com
ZEPTOMAIL_FROM_NAME=BuildPanda

# Frontend
VITE_API_BASE_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=buildpanda

# Backend
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buildpanda
DB_USER=postgres
DB_PASSWORD=postgres

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Allowed CORS / trusted origins (comma-separated): app (5173) + admin panel (5174)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Platform super-admins (comma-separated emails). These accounts are
# auto-promoted to the global `admin` role on login and can access the admin panel.
ADMIN_EMAILS=

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ZeptoMail (transactional email). Token is the "Zoho-enczapikey ..." send
# mail token from the ZeptoMail console. Leave empty in local dev to log
# emails to the console instead of sending them.
ZEPTOMAIL_TOKEN=your-zeptomail-send-mail-token
ZEPTOMAIL_FROM_ADDRESS=noreply@buildpanda.io
ZEPTOMAIL_FROM_NAME=BuildPanda
# Optional override for the logo used in email headers (defaults to
# BETTER_AUTH_URL/static/email-logo.png served by the backend)
# EMAIL_LOGO_URL=

# Inboxes that receive "Book a consultation" leads from buildpanda.io (comma-separated)
LEADS_NOTIFY_EMAIL=buildpanda.io@gmail.com,michaelade.build@gmail.com

# Object Storage — local dev uses MinIO via docker-compose; prod points at real S3.
# Leave S3_ENDPOINT blank in prod so the AWS SDK uses the default S3 endpoint.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=buildpanda
S3_FORCE_PATH_STYLE=true
S3_ENSURE_BUCKET=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Per-upload size limit in bytes (default 25 MB)
UPLOAD_MAX_BYTES=26214400

# Frontend
VITE_API_BASE_URL=http://localhost:3000

# Background jobs (Redis). Leave empty to run the queue in inline mode without
# a Redis server. In docker-compose / Railway set this to the Redis service URL.
REDIS_URL=redis://localhost:6379

# Panda AI (Moonshot / KIMI). Leave KIMI_API_KEY empty to use the built-in
# deterministic analyzer instead of calling the hosted model.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0905-preview

{
  "name": "@buildpanda/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup src/cluster.ts src/server.ts --format esm --dts",
    "start": "node dist/cluster.js",
    "db:migrate": "tsx ./node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "db:rollback": "tsx ./node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "db:seed": "tsx ./node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts",
    "db:make-migration": "tsx ./node_modules/knex/bin/cli.js migrate:make --knexfile knexfile.ts -x ts",
    "db:make-seed": "tsx ./node_modules/knex/bin/cli.js seed:make --knexfile knexfile.ts -x ts",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/lib-storage": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "3.1057.0",
    "@byteink/mppjs": "^0.1.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/env": "^5.0.0",
    "@fastify/multipart": "^10.0.0",
    "better-auth": "^1.5.6",
    "bullmq": "^5.77.6",
    "dproject": "^1.0.6",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "5.10.1",
    "knex": "^3.1.0",
    "mammoth": "^1.12.0",
    "mupdf": "^1.27.0",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "web-ifc": "0.0.77",
    "xlsx": "^0.18.5",
    "zeptomail": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "tsup": "^8.3.0",
    "typescript": "~5.7.0"
  }
}

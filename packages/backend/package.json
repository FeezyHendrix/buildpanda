{
  "name": "@buildpanda/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup src/cluster.ts src/server.ts --format esm --dts",
    "start": "node dist/cluster.js",
    "db:migrate": "tsx ./node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "db:rollback": "tsx ./node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "db:seed": "tsx ./node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts",
    "db:make-migration": "tsx ./node_modules/knex/bin/cli.js migrate:make --knexfile knexfile.ts -x ts",
    "db:make-seed": "tsx ./node_modules/knex/bin/cli.js seed:make --knexfile knexfile.ts -x ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/lib-storage": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "3.1057.0",
    "@byteink/mppjs": "^0.1.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/env": "^5.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@sendbyte/node": "^0.2.1",
    "@sentry/node": "^10.58.0",
    "@xeokit/xeokit-convert": "^1.3.2",
    "better-auth": "1.5.6",
    "bullmq": "^5.77.6",
    "cheerio": "^1.2.0",
    "decimal.js": "^10.6.0",
    "docx": "^9.7.1",
    "dproject": "^1.0.6",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.0",
    "geoip-lite": "^2.0.3",
    "ioredis": "5.10.1",
    "knex": "^3.1.0",
    "mammoth": "^1.12.0",
    "mupdf": "^1.27.0",
    "node-html-parser": "^7.1.0",
    "pdfjs-dist": "^6.0.227",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.0",
    "sharp": "^0.35.2",
    "tsx": "^4.19.0",
    "undici": "^8.5.0",
    "web-ifc": "0.0.77",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsup": "^8.3.0",
    "typescript": "~5.7.0"
  }
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*",
        "../mobile/src/*"
      ],
      "@/assets/*": [
        "../mobile/assets/*"
      ],
      "drizzle-orm": [
        "./node_modules/drizzle-orm/index.d.ts"
      ],
      "drizzle-orm/*": [
        "./node_modules/drizzle-orm/*"
      ],
      "@tanstack/react-query": [
        "./node_modules/@tanstack/react-query/build/modern/index.d.ts"
      ],
      "expo-sqlite": [
        "./node_modules/expo-sqlite/build/index.d.ts"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "@buildpanda/rich-content": [
        "./node_modules/@buildpanda/rich-content/src/index.ts"
      ],
      "@buildpanda/rich-content/*": [
        "./node_modules/@buildpanda/rich-content/src/*"
      ],
      "@buildpanda/voice-actions": [
        "./node_modules/@buildpanda/voice-actions/src/index.ts"
      ],
      "@buildpanda/voice-actions/*": [
        "./node_modules/@buildpanda/voice-actions/src/*"
      ],
      "@noble/ciphers/*": [
        "./node_modules/@noble/ciphers/*"
      ],
      "@noble/curves/*": [
        "./node_modules/@noble/curves/*"
      ],
      "@noble/hashes/*": [
        "./node_modules/@noble/hashes/*"
      ],
      "clsx": [
        "./node_modules/clsx/clsx.d.ts"
      ],
      "tailwind-merge": [
        "./node_modules/tailwind-merge/dist/types.d.ts"
      ]
    }
  }
}

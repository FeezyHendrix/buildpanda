{
  "name": "@buildpanda/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "lint": "eslint .",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:smoke": "playwright test --config e2e/playwright.config.ts --grep @smoke",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report e2e/.results/html",
    "e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@svar-ui/react-gantt": "^2.6.1",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-devtools": "^5.62.0",
    "@thatopen/components": "^3.4.6",
    "@thatopen/components-front": "^3.4.3",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-mention": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/suggestion": "^3.26.1",
    "@xeokit/xeokit-sdk": "^2.6.111",
    "axios": "^1.7.9",
    "better-auth": "1.5.6",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "pdfjs-dist": "6.0.227",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "react-svg": "^17.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "web-ifc": "^0.0.77",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "knex": "^3.2.7",
    "pg": "^8.20.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
